{
  "name": "relay-workspace",
  "version": "0.31.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "dev:native": "npm --prefix native run tauri dev",
    "build:native": "npm --prefix native run tauri build",
    "install:all": "npm --prefix native install && npm --prefix web install",
    "verify:rules": "node scripts/verify-commit-rules.js",
    "test": "npm --prefix native test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "typecheck": "npm --prefix native run typecheck && npm --prefix web exec tsc -- --noEmit"
  }
}
