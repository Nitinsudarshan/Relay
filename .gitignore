# dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*

# build & compiled target outputs
.next/
**/.next/
out/
dist/
**/dist/
target/
**/target/
.relay/
*.tsbuildinfo

# Relay Capture browser-extension bundles — produced by
# `npm --prefix native run build:extension` from native/src/webcapture/.
# The manifest, options page and README beside them are source and are tracked.
native/browser-extension/*.js

# Tauri-generated ACL/capability manifests — regenerated from
# native/src-tauri/capabilities on every build, not hand-edited.
native/src-tauri/gen/schemas/

# graphify code-graph tool output/cache — regenerated per run, not source.
graphify-out/

# environment & secrets
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
